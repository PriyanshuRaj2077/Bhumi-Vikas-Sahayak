# Copy to .env and fill in. Never commit .env.
# Without any key the app still runs in offline mode (calculators + rule search).

# --- AI provider: gemini | anthropic | auto (auto = whichever key is set, Anthropic first) ---
LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude (optional alternative)
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
EFFORT=low
# Server-side refusal fallbacks (Claude API only). Set 0 on Bedrock/Vertex/Foundry.
USE_FALLBACKS=1
# Keep the Claude prompt cache warm during office hours (1 = on)
PREWARM=0

# Cost guard: AI questions per day before falling back to offline answers
MAX_QUESTIONS_PER_DAY=300
