# Copy to .env and fill in. Never commit .env.
# Without a key the app still runs in offline mode (calculators + rule search).
ANTHROPIC_API_KEY=
# Model and effort for the answer engine
MODEL=claude-opus-5-5
EFFORT=low
# Server-side refusal fallbacks (Claude API only). Set 0 on Bedrock/Vertex/Foundry.
USE_FALLBACKS=1
# Keep the rulebook prompt cache warm during office hours (1 = on)
PREWARM=0
MAX_QUESTIONS_PER_DAY=2000
